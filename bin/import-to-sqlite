#!/usr/bin/env php
<?php

/**
 * Browser Reload CLI
 * 
 * Inicia o sistema de hot reload para navegadores.
 * Monitora mudanças em arquivos e notifica browsers conectados
 * para recarregar automaticamente.
 */

defined( "BASE_DIR" ) || define(
  "BASE_DIR", realpath(
    dirname( __DIR__, 4 ) 
  ) . DIRECTORY_SEPARATOR
);

/*
 * Define ENVs
 * */
putenv( "DATABASE_TYPE=sqlite" );
putenv( "DB_ENGINE=sqlite" );
putenv( "DB_DRIVER=sqlite" );
putenv( "DB_NAME=.ht.sqlite" );
putenv( "CONTENT_DIR=src" );

/*
 * Define REQUIRE
 * */
require_once BASE_DIR . "vendor/autoload.php";
require_once BASE_DIR . "vendor/websyspro/wpengine/src/Core/wp-load.php";

use Websyspro\WpEngine\Shareds\WordpressImport;
global $wpdb;

$wordpressImport = new WordpressImport( "localhost", "3306", "edocente_admin", "root", "qazwsx", BASE_DIR, $wpdb );
$wordpressImport->importStructureFromTable();
// $wordpressImport->importRegisterFromTable();