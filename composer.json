{
  "name": "websyspro/wp-engine",
  "version": "1.0.6",
  "description": "WordPress runtime installer for Composer-based projects",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Websyspro\\WpEngine\\": "src/"
    }
  },
  "bin": [
    "bin/install"
  ],
  "scripts": {
    "publish": "php vendor/bin/publish"
  },
  "extra": {
    "wp-engine": {
      "wordpress": "6.9",
      "locale": "pt_BR"
    }
  },
  "require": {
    "websyspro/package": "^1.0",
    "websyspro/utils": "^1.0",
    "websyspro/logger": "^1.0",
    "websyspro/devtools": "^1.0"
  }
}
